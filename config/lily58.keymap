#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

// Layer numbers. Each conditional then-layer sits above its if-layers.
#define BASE     0
#define SYM_L    1
#define SYM_R    2
#define NAV      3
#define ADJUST   4

/ {
    combos {
        compatible = "zmk,combos";
        // U + I pressed together = Backspace
        combo_bspc {
            timeout-ms = <18>;
            key-positions = <19 20>;
            require-prior-idle-ms = <175>;
            layers = <0>;
            bindings = <&kp BSPC>;
        };

        // Q + W pressed together = Esc
        combo_esc {
            timeout-ms = <18>;
            key-positions = <13 14>;
            require-prior-idle-ms = <175>;
            layers = <0>;
            bindings = <&kp ESC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust {
            if-layers = <NAV SYM_R>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   `   |
// | CAPSW |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// |       |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   |  DEL  |
//                     |      | NAV  | SYML |  SPC   |  |  RET  | SYMR  | BSPC  |       |
            bindings = <
&kp ESC    &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                     &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB    &kp Q  &kp W  &kp E    &kp R    &kp T                      &kp Y  &kp U    &kp I     &kp O   &kp P    &kp GRAVE
&caps_word &kp A &kp S &kp D &kp F &kp G                          &kp H  &kp J &kp K &kp L &kp SEMI &kp SQT
&none      &kp Z  &kp X  &kp C    &kp V    &kp B  &kp LBKT   &kp RBKT &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp DEL
                        &none    &mo NAV  &mo SYM_L  &kp SPACE    &kp RET   &mo SYM_R  &kp BSPC  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_l_layer {
// ------------------------------------------------------------------------------------------------------------
// Left Sym thumb changes the left half only. The right half stays on the base layer,
// so the left home row modifiers reach every right-hand key.
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |       |       |      |       |       |
// |       |  ~  |  (  |  )   |  :   |  |   |                   |      |       |       |      |       |       |
// |       | Ctl | Alt | Sup | RSft |  &   |                   |      |       |       |      |       |       |
// |       |  !  |  _  |  [   |  ]   |  %   |        |  |       |      |       |       |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            display-name = "SymL";
            bindings = <
&kp F1 &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                     &trans    &trans     &trans     &trans    &trans     &trans
&trans &kp TILDE &kp LPAR  &kp RPAR  &kp COLON &kp PIPE                   &trans    &trans     &trans     &trans    &trans     &trans
&trans &kp LCTRL &kp LALT  &kp LGUI  &kp RSHFT &kp AMPS                   &trans    &trans     &trans     &trans    &trans     &trans
&trans &kp EXCL  &kp UNDER &kp LBKT  &kp RBKT  &kp PRCNT &trans  &trans   &trans    &trans     &trans     &trans    &trans     &trans
                           &trans    &trans    &trans    &trans     &trans   &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_r_layer {
// ------------------------------------------------------------------------------------------------------------
// Right Sym thumb changes the right half only. The left half stays on the base layer,
// so the right home row modifiers reach every left-hand key.
// Outer top stays ` and outer bottom stays Del. The quote key is ? while this layer is held.
// * is the period key on this layer. : is SymL R.
// |       |     |     |      |      |      |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |       |     |     |      |      |      |                   |  ^   |  =    |  +    |  -   |   $   |       |
// |       |     |     |      |      |      |                   |  #   | RSft  | Sup  | Alt  | Ctrl  |   ?   |
// |       |     |     |      |      |      |        |  |       |  @   |  {    |  }    |  *   |   \   |       |
//                     |      |      |      |        |  |       |      |       |       |
            display-name = "SymR";
            bindings = <
&trans &trans    &trans    &trans    &trans    &trans                     &kp F7    &kp F8     &kp F9     &kp F10   &kp F11    &kp F12
&trans &trans    &trans    &trans    &trans    &trans                     &kp CARET &kp EQUAL  &kp PLUS   &kp MINUS &kp DOLLAR &trans
&trans &trans    &trans    &trans    &trans    &trans                     &kp HASH  &kp RSHFT  &kp RGUI   &kp LALT  &kp RCTRL  &kp QMARK
&trans &trans    &trans    &trans    &trans    &trans    &trans  &trans   &kp AT    &kp LBRC   &kp RBRC   &kp ASTRK &kp BSLH   &trans
                           &trans    &trans    &trans    &trans     &trans   &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   | MUTE | VOL-  | VOL+  | BRI- | BRI+  |       |
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// Left home row is Ctrl, Alt, Super, Right Shift while this layer is held.
// |       | Ctl | Alt | Sup | RSft |      |                   |  <-  |   v   |   ^   |  ->  |       |       |
// |       |     |     |      |      |      |        |  |       |      |       |       |      |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&trans    &trans &trans &trans  &trans  &trans                       &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &trans
&trans    &trans &trans &trans  &trans  &trans                       &trans      &trans    &trans    &trans   &trans    &trans
&trans    &kp LCTRL &kp LALT &kp LGUI &kp RSHFT &trans               &kp LEFT    &kp DOWN  &kp UP    &kp RIGHT &trans   &trans
&trans    &trans &trans &trans  &trans  &trans    &trans   &trans    &trans      &trans    &trans    &trans   &trans    &trans
                        &trans  &trans  &trans    &trans   &trans    &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
// ------------------------------------------------------------------------------------------------------------
// Nav and right Sym held together.
// | BTCLR | BT1  | BT2  | BT3  |  BT4 |  BT5 |                   |      |       |       |      |       |       |
// |       |EP_ON |EP_OFF|EP_TOG|      |      |                   |      |       |       |      |       |       |
// |       |      |      |      |      |      |                   |      |       |       |      |       |       |
// |       |      |      |      |      |      |        |  |       |      |       |       |      |       |       |
//                       |      |      |      |        |  |       |      |       |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4                 &trans &trans &trans &trans &trans &trans
&trans     &ext_power EP_ON &ext_power EP_OFF &ext_power EP_TOG &trans       &trans                       &trans &trans &trans &trans &trans &trans
&trans     &trans           &trans            &trans            &trans       &trans                       &trans &trans &trans &trans &trans &trans
&trans     &trans           &trans            &trans            &trans       &trans    &trans   &trans    &trans &trans &trans &trans &trans &trans
                                              &trans            &trans       &trans    &trans   &trans    &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
